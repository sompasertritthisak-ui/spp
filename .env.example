# ── Public (safe in the browser; baked into the static build) ──────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set by CI for GitHub Pages project sites, e.g. /spp-platform. Empty for custom domains.
NEXT_PUBLIC_BASE_PATH=

# ── Secrets: NEVER put these here for the static site. ─────────────────────
# They live only as Supabase Edge Function secrets (supabase secrets set ...):
#   ANTHROPIC_API_KEY      – SPP AI Design Assistant
#   GITHUB_DISPATCH_TOKEN  – fine-grained PAT, "Contents: read, Actions: write" on this repo
#   GITHUB_REPO            – owner/repo
#   RESEND_API_KEY         – transactional email (optional)
